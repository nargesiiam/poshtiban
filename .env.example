# این فایل را کپی کن به .env و مقادیر واقعی را جایگزین کن
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=changeme_local_only

# --- RabbitMQ ---
RABBITMQ_USER=relay
RABBITMQ_PASSWORD=changeme_local_only

# --- Django ---
DJANGO_SECRET_KEY=changeme_generate_a_real_one
DJANGO_DEBUG=1

# --- LLM / Search providers ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
SERPER_API_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
